{
  "name": "bible-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Large-button Bible reader that reads aloud, built for low vision.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "icons": "node scripts/make-icons.mjs",
    "bible": "python3 scripts/build-bible.py"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.1.0"
  },
  "devDependencies": {
    "sharp": "^0.34.0",
    "typescript": "^5.6.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
